# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Product Hunt & GitHub
PRODUCTHUNT_API_KEY=your_producthunt_token
GITHUB_TOKEN=your_github_token

# Web Scraping (ScrapingAnt)
SCRAPINGANT_API_KEY=primary_key_here
SCRAPINGANT_API_KEYS=key1,key2,key3,key4

# AI Model Inference & Cascading Fallbacks
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
NVIDIA_API_KEY=your_nvidia_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Image Generation & Cover Assets
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
